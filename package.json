{
  "name": "@foss-earth/preview-sheets",
  "version": "0.1.0",
  "private": true,
  "description": "Preview cubemap sheet schema, packing, equivalence verification and shared source acquisition",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./preparation": {
      "types": "./node/preparation.d.mts",
      "import": "./node/preparation.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./schema/extension.json": "./schema/extension.json",
    "./schema/place.json": "./schema/place.json",
    "./scene-extension": {
      "types": "./dist/sceneExtension.d.ts",
      "import": "./dist/sceneExtension.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "files": [
    "dist",
    "src",
    "node",
    "schema",
    "tsconfig.json",
    "LICENSE",
    "NOTICE",
    "SOURCE_PROVENANCE.json",
    "SOURCE_LINEAGE.json",
    "README.md",
    "docs",
    "SOURCE_RECEIPT.json",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".attribution.json",
    ".attribution-release.json",
    ".github/workflows/attribution-check.yml",
    "deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test": "vitest run --maxWorkers=50%",
    "ci": "npm run check:conformance && npm run check:implementation",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck:consumer": "tsc -p tests/tsconfig.json",
    "check:implementation": "npm run lint && npm run typecheck && npm run build && npm test && node scripts/check-public-consumer.mjs && npm run typecheck:consumer",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "globals": "17.6.0",
    "@foss-earth/ci": "file:deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz"
  },
  "fossEarthSplit": {
    "sourceRevision": "90e23b3ee96f53ec5900afc5991a21fffa58649d",
    "admission": "pending pinned foss-earth/ci caller, shared conformance and coordinator lineage acceptance"
  },
  "dependencies": {
    "@foss-earth/cubemap": "0.1.0",
    "@foss-earth/images": "0.1.0"
  },
  "peerDependencies": {
    "@foss-earth/ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/ui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/preview-sheets.git"
  }
}
