{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-earth.github.io/preview-sheets/schema/extension.json",
  "title": "foss-earth.preview-sheets document extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheets"
  ],
  "properties": {
    "sheets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "mimeType",
          "width",
          "height",
          "encodedBytes",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "mimeType": {
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "encodedBytes": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
