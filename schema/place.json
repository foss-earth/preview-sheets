{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-earth.github.io/preview-sheets/schema/place.json",
  "title": "foss-earth.preview-sheets cube placement extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "x",
    "y"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "x": {
      "type": "integer",
      "minimum": 0
    },
    "y": {
      "type": "integer",
      "minimum": 0
    }
  }
}
